# ==============================================================================
# TrustLayerLabs - Lead Delivery Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Keep API keys strictly server-side. Never prefix with NEXT_PUBLIC_.
# - Do not commit real secrets or .env.local to Git.
# - Configure these environment variables in your deployment platform (Vercel, AWS, etc.).

# ------------------------------------------------------------------------------
# 1. Lead Webhook URL (Priority 1 Delivery)
# ------------------------------------------------------------------------------
# Primary delivery channel: Webhook URL that accepts JSON POST payloads.
# Compatible with Slack incoming webhooks, Discord, Zapier, Make, n8n, or internal CRM.
# Example: https://hooks.slack.com/services/T00/B00/XXXXX
LEAD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 2. Resend API Key (Priority 2 Delivery - Transactional Email)
# ------------------------------------------------------------------------------
# Used when LEAD_WEBHOOK_URL is unset or fails.
# Sends lead notifications to ceo@trustlayerlabs.co.in.
# Get your API key from https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Sender Email Address: Must use your verified custom domain in Resend
# (e.g., leads@trustlayerlabs.co.in or notifications@trustlayerlabs.co.in).
# Note: For initial testing before domain DNS verification, Resend allows 'onboarding@resend.dev'.
LEADS_FROM_EMAIL=leads@trustlayerlabs.co.in

# Recipient Email Address: Where enquiry alerts will be delivered.
LEADS_TO_EMAIL=ceo@trustlayerlabs.co.in

# ------------------------------------------------------------------------------
# 3. Google Tag Manager (GTM) & Google Analytics (GA4)
# ------------------------------------------------------------------------------
# Provide your GTM container ID to load the GTM container script and noscript iframe.
# Example: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# GA4 Measurement ID (defaults to G-51DXDHGGHS if not set)
NEXT_PUBLIC_GA_ID=G-51DXDHGGHS

# ------------------------------------------------------------------------------
# 4. Microsoft Clarity
# ------------------------------------------------------------------------------
# Session recording and heatmaps. Disabled when unset.
# Respects cookie consent preferences before initializing.
NEXT_PUBLIC_CLARITY_ID=

# ------------------------------------------------------------------------------
# 5. On-Demand ISR Cache Revalidation Secret
# ------------------------------------------------------------------------------
# Secret token to authorize on-demand cache revalidation via /api/revalidate.
# Example: a random 32+ character hex string or uuid
REVALIDATE_SECRET=
